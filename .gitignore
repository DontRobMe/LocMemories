# Builds et caches Gradle / Kotlin
.gradle/
.kotlin/
build/
/build42
.externalNativeBuild/
.cxx/

# Fichiers générés hors de build/ (export manuel, Build > Generate Signed Bundle / APK)
*.apk
*.aab
*.ap_
/app/release/
/app/benchmark/

# Secrets : configuration locale (chemin du SDK) et clés de signature
local.properties
*.jks
*.keystore

# Android Studio : ignoré sauf les réglages partagés (style de code, inspections,
# configuration Git), utiles à toute l'équipe.
*.iml
/.idea/*
!/.idea/.gitignore
!/.idea/AndroidProjectSystem.xml
!/.idea/codeStyles/
!/.idea/inspectionProfiles/
!/.idea/runConfigurations.xml
!/.idea/vcs.xml
/captures/
*.hprof

# Système
.DS_Store
Thumbs.db
desktop.ini
